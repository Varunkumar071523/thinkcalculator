# Copy to .env.local for local overrides. Never commit real values — see docs/DECISIONS.md
# (Sprint 36 entry) for how each of these is gated and why.

# GA4 measurement ID (e.g. "G-XXXXXXXXXX"). Only takes effect on a STATIC_EXPORT=true build (see
# scripts/build-export.mjs) — it is intentionally inert under `next dev`, `next start`, and the
# Playwright e2e suite so test runs never pollute production analytics data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (the content value of the
# <meta name="google-site-verification" ...> tag Search Console gives you). Rendered on every
# build when set; does not depend on STATIC_EXPORT.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
